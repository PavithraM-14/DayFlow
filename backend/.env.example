# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dayflow

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Email / OTP delivery (SMTP)
# Leave EMAIL_USER and EMAIL_PASS empty in local development: the sign-up
# OTP is then printed to the server console (and returned as `devOtp` in
# the API response) instead of being emailed, so the flow is testable
# without credentials. In production both are required.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Dayflow <no-reply@dayflow.app>

# OTP behaviour
OTP_EXPIRY_MINUTES=10
SIGNUP_STAGING_TTL_MINUTES=60

# Company logo upload cap, in bytes (default 2 MB)
MAX_LOGO_BYTES=2097152

# Auth / sessions
# Signs the login JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production — the server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
